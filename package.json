{
  "name": "@speedcubingireland/typecomp",
  "version": "1.0.0",
  "description": "Deterministic, live-safe WCIF assignment planning for WCA competitions",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": [
    "src",
    "examples"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test:coverage && bun run package:check",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "package:check": "bun pm pack --dry-run --ignore-scripts",
    "prepack": "bun run check",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "wca",
    "wcif",
    "speedcubing",
    "competition",
    "group-assignment"
  ],
  "author": "Speedcubing Ireland",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpeedcubingIreland/TypeComp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@wca/helpers": "^1.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
